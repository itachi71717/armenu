{
  "rewrites": [
    {
      "source": "/how",
      "destination": "/how.html"
    },
    {
      "source": "/dishes",
      "destination": "/dishes.html"
    },
    {
      "source": "/why",
      "destination": "/why.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/faqs",
      "destination": "/faq.html"
    },
    {
      "source": "/plans",
      "destination": "/plans.html"
    },
    {
      "source": "/pricing",
      "destination": "/plans.html"
    },
    {
      "source": "/demo",
      "destination": "/dishes.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/legal",
      "destination": "/legal.html"
    },
    {
      "source": "/terms",
      "destination": "/legal.html"
    },
    {
      "source": "/privacy",
      "destination": "/legal.html"
    },
    {
      "source": "/status",
      "destination": "/status.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?path=sitemap"
    },
    {
      "source": "/staff",
      "destination": "/staff/index.html"
    },
    {
      "source": "/staff/",
      "destination": "/staff/index.html"
    },
    {
      "source": "/kitchen",
      "destination": "/kitchen/index.html"
    },
    {
      "source": "/kitchen/",
      "destination": "/kitchen/index.html"
    },
    {
      "source": "/discover",
      "destination": "/discover.html"
    },
    {
      "source": "/m/:slug",
      "destination": "/menu.html?r=:slug"
    },
    {
      "source": "/t/:slug/:table",
      "destination": "/menu.html?r=:slug&t=:table"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PATCH,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type,Authorization,x-admin-secret"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/schema.sql"
    }
  }
}
