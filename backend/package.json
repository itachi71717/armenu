{
  "name": "armenu-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create armenu-db",
    "db:migrate": "wrangler d1 execute armenu-db --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute armenu-db --remote --file=./schema.sql",
    "r2:create": "wrangler r2 bucket create armenu-assets"
  },
  "dependencies": {
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
